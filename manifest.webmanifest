{
  "name": "Folio",
  "short_name": "Folio",
  "description": "한글, 엑셀, 워드, 파워포인트, PDF를 광고 없이 바로 여는 문서 뷰어. 스캔, 서명, 양식, 글자 인식까지.",
  "lang": "ko",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#4338ca",
  "theme_color": "#f6f3ec",
  "icons": [
    {
      "src": "icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "orientation": "any",
  "share_target": {
    "action": "./share",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [
        {
          "name": "file",
          "accept": [
            "application/*",
            "text/*",
            "image/*",
            "message/rfc822"
          ]
        }
      ]
    }
  },
  "file_handlers": [
    {
      "action": "./?opened=1",
      "accept": {
        "application/pdf": [
          ".pdf"
        ],
        "application/x-hwp": [
          ".hwp",
          ".hwpx",
          ".hml"
        ],
        "application/vnd.openxmlformats-officedocument.wordprocessingml.document": [
          ".docx"
        ],
        "application/msword": [
          ".doc"
        ],
        "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet": [
          ".xlsx",
          ".xlsm"
        ],
        "application/vnd.ms-excel": [
          ".xls"
        ],
        "text/csv": [
          ".csv"
        ],
        "application/vnd.openxmlformats-officedocument.presentationml.presentation": [
          ".pptx"
        ],
        "application/vnd.ms-powerpoint": [
          ".ppt"
        ],
        "application/vnd.oasis.opendocument.text": [
          ".odt"
        ],
        "application/epub+zip": [
          ".epub"
        ],
        "message/rfc822": [
          ".eml"
        ],
        "text/markdown": [
          ".md"
        ],
        "application/zip": [
          ".zip"
        ],
        "application/x-7z-compressed": [
          ".7z"
        ]
      }
    }
  ]
}
